managed implementation in class ZCL_R_TB_PO_LOG_ITEM unique;
strict ( 2 );
with draft;
define behavior for ZR_TB_PO_LOG_ITEM alias PurchaseOrderLog
persistent table ZTB_PO_LOG_ITEM
draft table ZTB_PO_LOG_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )

{
  field ( mandatory : create )
   Purchaseorder,
   Purchaseorderitem,
   Logtype;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( readonly : update )
   Purchaseorder,
   Purchaseorderitem,
   Logtype;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZTB_PO_LOG_ITEM
  {
    Purchaseorder = purchaseorder;
    Purchaseorderitem = purchaseorderitem;
    Logtype = logtype;
    SendDate = send_date;
    SendTime = send_time;
    CpiMsg = cpi_msg;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
  }
}